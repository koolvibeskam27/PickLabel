<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/txtPrinter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:text="Current Printer: None Selected"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <EditText
            android:id="@+id/etPrinter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Scan Printer MAC Barcode"
            android:minHeight="56dp"
            android:singleLine="true"
            android:textSize="18sp" />
        <Button
            android:id="@+id/btnSetPrinter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SET PRINTER" />
        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Name"
            android:minHeight="56dp"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etWO"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Work Order (6 Digits)"
            android:inputType="number"
            android:maxLength="6"
            android:minHeight="56dp"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Item Number"
            android:minHeight="56dp"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etQty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Quantity"
            android:inputType="number"
            android:minHeight="56dp"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etLot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Lot Number (Optional)"
            android:minHeight="56dp"
            android:textSize="18sp" />
        <EditText
            android:id="@+id/etLoc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Location"
            android:minHeight="56dp"
            android:textSize="18sp"/>

        <Button
            android:id="@+id/btnPrint"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="PRINT"
            android:textSize="22sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="CLEAR"
            android:textSize="22sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:padding="16dp"
            android:contentDescription="Label Preview" />


    </LinearLayout>

</ScrollView>